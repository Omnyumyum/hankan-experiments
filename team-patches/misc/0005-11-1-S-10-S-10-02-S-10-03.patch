- S-10-03: 놓은 칸이 「장면 3」처럼 정답 번호를 보여 줬다. 이제 놓은 카드의
  문장을 보여 준다.
- S-10-02: sort(() => Math.random() - 0.5) 로 섞어서 처음부터 정답 순서일
  수 있었다 (2장이면 절반). 고르게 섞고, 정답 순서가 나오면 다시 섞는다.
- S-10-05 틀렸을 때 말없이 비워지는 것은 05 표 그대로(「원위치로 돌아가고
  다시 해 볼 수 있다. 부정적 표현을 쓰지 않는다」)라 두었다.
  한마디나 소리를 더할지는 결정이 필요하다 (F-PLY-05).
---
 src/screens/S10Order.tsx | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/screens/S10Order.tsx b/src/screens/S10Order.tsx
index 9b4fc54..bae6e80 100644
--- a/src/screens/S10Order.tsx
+++ b/src/screens/S10Order.tsx
@@ -28,9 +28,18 @@ export default function S10Order() {
   }, [story]);
   const count = Math.min(level === 1 ? 2 : 4, lines.length);
 
+  // 섞은 결과가 처음부터 정답 순서면 다시 섞는다 (2장이면 절반이 그대로 맞는다)
   const cards = useMemo(() => {
     const src = lines.slice(0, count).map((text, index) => ({ index, text }));
-    return [...src].sort(() => Math.random() - 0.5);
+    let out = src;
+    while (src.length > 1 && out.every((c, n) => c.index === n)) {
+      out = [...src];
+      for (let i = out.length - 1; i > 0; i--) {
+        const j = Math.floor(Math.random() * (i + 1));
+        [out[i], out[j]] = [out[j], out[i]];
+      }
+    }
+    return out;
   }, [lines, count]);
 
   const [slots, setSlots] = useState<(number | null)[]>(Array(count).fill(null));
@@ -96,7 +105,8 @@ export default function S10Order() {
                 setSlots(slots.map((x, m) => (m === n ? null : x)));
               }
             }}>
-            {v === null ? n + 1 : `장면 ${v + 1}`}
+            {/* 놓은 카드는 그 문장으로 보인다. 「장면 3」처럼 쓰면 정답 번호가 드러난다 */}
+            {v === null ? n + 1 : <span className="hint" style={{ fontSize: "var(--t-label)", color: "var(--ink)" }}>{lines[v]}</span>}
           </button>
         ))}
       </div>
