브라우저가 열지 못하는 사진(HEIC 등)은 createImageBitmap 이 실패하는데
잡는 곳이 없어 아무 일도 일어나지 않았다. 실패하면 받지 않은 파일과 같은
안내 상자를 띄우고 읽어 준다. 사진 올리기를 켰을 때만 생기는 일이다.
---
 src/screens/S03Upload.tsx | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/screens/S03Upload.tsx b/src/screens/S03Upload.tsx
index 5009c40..77df981 100644
--- a/src/screens/S03Upload.tsx
+++ b/src/screens/S03Upload.tsx
@@ -36,7 +36,13 @@ export default function S03Upload() {
     }
     setRejected(false);
     setBusy(true);
-    setFile(await shrink(f));           // 긴 변 1600px, JPEG 0.85 로 줄여서 보낸다
+    try {
+      setFile(await shrink(f));         // 긴 변 1600px, JPEG 0.85 로 줄여서 보낸다
+    } catch {
+      // 브라우저가 열지 못한 그림 (HEIC 등). 받지 않은 파일과 같이 알린다 (S-03-09)
+      setRejected(true);
+      speak(REJECTED, muteAll);
+    }
     setBusy(false);
   };
 
