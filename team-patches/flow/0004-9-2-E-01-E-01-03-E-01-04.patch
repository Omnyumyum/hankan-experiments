S-04 분석이 몇 번 연속 걸러졌는지 세는 곳이 없어 같은 안내로 계속 돌려보냈다.
src/store/retry.ts 에 횟수를 두고 S-04 에서 센다 (성공하면 0).
- 2회: 보조 안내 「화면에 그려 볼까요?」, 버튼 「화면에 그리기」 → S-03D
- 3회부터: 보조 안내 「옆에 있는 어른에게 도와 달라고 해 볼까요?」, 버튼은 그대로 S-03D
- ENGINE_ERROR · CONTENT_BLOCKED 는 세지 않는다
지원 수준 1 전용 규칙(1회에 S-03D)은 넣지 않았다 (10/27 수준 2 고정 결정).
근거: 05 E-01 「반복해서 걸러질 때」, 06 4-3, 03 F-CHR-07
---
 src/screens/E01Error.tsx     | 11 +++++++++--
 src/screens/S04Analyzing.tsx |  7 +++++--
 src/store/retry.ts           | 16 ++++++++++++++++
 3 files changed, 30 insertions(+), 4 deletions(-)
 create mode 100644 src/store/retry.ts

diff --git a/src/screens/E01Error.tsx b/src/screens/E01Error.tsx
index 0bd0cff..c16ba7a 100644
--- a/src/screens/E01Error.tsx
+++ b/src/screens/E01Error.tsx
@@ -6,6 +6,7 @@ import { useSession } from "@/store/session";
 import { DRAW_TEXT, ERROR_TEXT } from "@/lib";
 import { useWithAdult } from "@/store/settings";
 import { STEP_ORDER } from "@/types/story";
+import { isPictureError, pictureFails } from "@/store/retry";
 
 /** 모달이 아니라 전체 화면으로 띄운다. 배경이 비치면 아이가 혼란스러워한다. */
 export default function E01Error() {
@@ -14,7 +15,13 @@ export default function E01Error() {
   const { photo } = useWithAdult();
   const base = ERROR_TEXT[errorCode ?? "ENGINE_ERROR"] ?? ERROR_TEXT.ENGINE_ERROR;
   // 사진 올리기가 꺼져 있으면(F-SET-06 기본) 그림은 화면에서 그린 것이다. 「찍기」 대신 「그리기」로 말한다
-  const t = !photo && DRAW_TEXT[errorCode ?? ""] ? { ...base, ...DRAW_TEXT[errorCode ?? ""] } : base;
+  const once = !photo && DRAW_TEXT[errorCode ?? ""] ? { ...base, ...DRAW_TEXT[errorCode ?? ""] } : base;
+  // 그림이 연속으로 걸러지면 같은 안내로 돌려보내지 않는다 (05 E-01 「반복해서 걸러질 때」).
+  // 2회면 화면에 그리기(S-03D)를 권하고, 3회부터는 어른을 부르게 한다. 버튼은 계속 S-03D 로 간다
+  const fails = isPictureError(errorCode) ? pictureFails() : 0;
+  const t = fails >= 3 ? { ...once, hint: "옆에 있는 어른에게 도와 달라고 해 볼까요?", primary: "화면에 그리기" }
+    : fails === 2 ? { ...once, hint: "화면에 그려 볼까요?", primary: "화면에 그리기" }
+    : once;
 
   const primary = () => {
     setError(null);
@@ -24,7 +31,7 @@ export default function E01Error() {
       nav("/steps");
       return;
     }
-    nav(errorCode === "ENGINE_ERROR" ? "/" : "/upload");
+    nav(fails >= 2 ? "/draw" : errorCode === "ENGINE_ERROR" ? "/" : "/upload");
   };
 
   return (
diff --git a/src/screens/S04Analyzing.tsx b/src/screens/S04Analyzing.tsx
index 20d9a5e..f8d1e55 100644
--- a/src/screens/S04Analyzing.tsx
+++ b/src/screens/S04Analyzing.tsx
@@ -8,6 +8,7 @@ import { useSession } from "@/store/session";
 import { useSettings } from "@/store/settings";
 import { analyzeCharacter, ApiError, ENGINE } from "@/api";
 import type { JobStatus } from "@/types/character";
+import { countAnalysis } from "@/store/retry";
 
 /** 백엔드 job 상태(계약 1-3)를 대기 점 세 개로 보여준다 */
 const STEP: Record<JobStatus, number> = { pending: 1, running: 2, succeeded: 3, failed: 0 };
@@ -24,7 +25,7 @@ export default function S04Analyzing() {
   useEffect(() => {
     if (!file) { nav("/upload", { replace: true }); return; }
     const t = setTimeout(() => setShowStop(true), 3000);
-    const timeout = setTimeout(() => { setError("ENGINE_TIMEOUT"); nav("/error"); }, 30000);
+    const timeout = setTimeout(() => { countAnalysis("ENGINE_TIMEOUT"); setError("ENGINE_TIMEOUT"); nav("/error"); }, 30000);
     // effect 안에서 새로 만든다. ref 에 담아 두면 StrictMode 의 두 번째 실행이
     // 첫 실행 cleanup 에서 이미 끊긴 signal 을 물려받아 분석이 시작되지 않는다
     const ctrl = new AbortController();
@@ -36,12 +37,14 @@ export default function S04Analyzing() {
       setDiag(`${s} · ${Math.round(performance.now() - started)}ms · ${ENGINE}`);
     }, ctrl.signal, useSettings.getState().keepOriginal)
       .then((c) => {
+        countAnalysis(null);
         setCharacter(c);
         nav("/confirm", { replace: true });
       })
       .catch((e) => {
         if ((e as Error).name === "AbortError") return;
-        setError(e instanceof ApiError ? e.code : "ENGINE_ERROR"); nav("/error");
+        const code = e instanceof ApiError ? e.code : "ENGINE_ERROR";
+        countAnalysis(code); setError(code); nav("/error");
       });
 
     return () => { clearTimeout(t); clearTimeout(timeout); ctrl.abort(); };
diff --git a/src/store/retry.ts b/src/store/retry.ts
new file mode 100644
index 0000000..b543945
--- /dev/null
+++ b/src/store/retry.ts
@@ -0,0 +1,16 @@
+/** E-01 「반복해서 걸러질 때」 (pt_docs 05 E-01, 06 4-3). 그림 분석(S-04)이 연속으로 걸러진 횟수.
+ *  한 번 성공하면 0 으로 돌린다. ENGINE_ERROR · CONTENT_BLOCKED 는 그림 문제가 아니라 세지 않는다.
+ *  메모리에만 둔다 — 새로고침하면 처음부터 센다 */
+let fails = 0;
+
+/** 반복 셈에 넣는 오류인지 */
+export const isPictureError = (code: string | null) =>
+  !!code && code !== "ENGINE_ERROR" && code !== "CONTENT_BLOCKED";
+
+/** S-04 분석 결과를 센다. 성공이면 null */
+export function countAnalysis(code: string | null) {
+  if (code === null) fails = 0;
+  else if (isPictureError(code)) fails += 1;
+}
+
+export const pictureFails = () => fails;
-- 
